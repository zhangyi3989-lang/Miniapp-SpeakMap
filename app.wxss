page {
  background: #fff9f1;
  color: #352c29;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}
.page {
  padding: 36rpx 32rpx 64rpx;
  max-width: 900rpx;
  margin: auto;
}
.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
.logo {
  width: 68rpx;
  height: 68rpx;
  background: #e66735;
  color: white;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(-7deg);
  font-size: 40rpx;
}
.eyebrow {
  color: #a36d50;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  margin-top: 24rpx;
}
.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 750;
  margin: 12rpx 0 20rpx;
}
.subtitle {
  font-size: 32rpx;
  font-weight: 650;
  margin-bottom: 12rpx;
}
.muted {
  color: #857870;
  font-size: 25rpx;
}
.small {
  font-size: 23rpx;
}
.card {
  background: #fffdf9;
  border: 1rpx solid #eee1d4;
  border-radius: 30rpx;
  padding: 28rpx;
  margin: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(78, 48, 27, 0.035);
}
.hero {
  background: #ffecdb;
  border-color: #f6d2b6;
}
.purple {
  background: #f0ebfa;
  border-color: #e3d9f5;
}
.green {
  background: #eaf2e8;
  border-color: #d6e5d3;
}
.blue {
  background: #edf3f8;
}
.pink {
  background: #f9ecee;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.stat {
  flex: 1;
  min-width: 160rpx;
  border-radius: 22rpx;
  padding: 20rpx;
  background: #fffdf9;
}
.number {
  font-size: 42rpx;
  font-weight: 750;
  color: #6d568e;
}
.badge {
  display: inline-block;
  border-radius: 12rpx;
  background: #f6e6d9;
  color: #9a5837;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
}
.tag {
  border-radius: 12rpx;
  background: #f0ebfa;
  color: #74608a;
  font-size: 23rpx;
  padding: 7rpx 14rpx;
  margin: 6rpx 10rpx 6rpx 0;
  display: inline-block;
}
.tag.active {
  background: #e66735;
  color: white;
}
.demo {
  font-size: 23rpx;
  color: #826548;
  background: #f7ecd9;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  margin: 20rpx 0;
}
.empty {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #857870;
}
button {
  font-size: 28rpx;
  font-weight: 650;
  border-radius: 22rpx;
  line-height: 1.5;
  padding: 22rpx 24rpx;
  margin: 16rpx 0;
  background: #f2e9df;
  color: #574a42;
}
button::after {
  border: 0;
}
button.primary {
  background: #e66735;
  color: white;
}
button.secondary {
  background: #eee7f7;
  color: #6c518c;
}
button.danger {
  background: #f8e2e2;
  color: #a14343;
}
button[disabled] {
  opacity: 0.5;
}
textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 230rpx;
  background: #fffdf9;
  border: 2rpx solid #e6d8c9;
  border-radius: 22rpx;
  padding: 22rpx;
  font-size: 29rpx;
  line-height: 1.65;
  margin: 18rpx 0;
}
input {
  background: #fffdf9;
  border: 2rpx solid #e6d8c9;
  border-radius: 18rpx;
  height: 84rpx;
  padding: 0 20rpx;
  margin: 16rpx 0;
}
.label {
  font-size: 25rpx;
  color: #857870;
  margin-top: 20rpx;
}
.english {
  font-size: 33rpx;
  font-weight: 650;
  line-height: 1.5;
  word-break: break-word;
}
.text {
  white-space: pre-wrap;
  word-break: break-word;
}
.line {
  border-bottom: 1rpx solid #eee1d4;
  padding: 16rpx 0;
}
.map {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.node {
  font-size: 23rpx;
  background: #eee8e0;
  color: #857870;
  padding: 10rpx 14rpx;
  border-radius: 15rpx;
}
.node.active {
  background: #e66735;
  color: white;
}
.node.done {
  background: #e1ecdd;
  color: #51784b;
}
.error {
  background: #fae7e2;
  color: #a14b34;
  padding: 18rpx;
  border-radius: 16rpx;
}
.link {
  color: #a65430;
}
.spacer {
  height: 20rpx;
}
checkbox {
  transform: scale(0.85);
}
.candidate {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee1d4;
}
