/* SpeakMap 宣传册视觉：杏色纸张、白色便签、黄色标记、深蓝文字。 */
page {
  background: #ffe1c5;
  color: #174764;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}
.page {
  box-sizing:border-box;padding:30rpx 28rpx 44rpx;max-width:900rpx;margin:0 auto;
}
.eyebrow {
  color: #728a7b;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin-top: 12rpx;
  font-weight: 650;
}
.title {
  color: #17211b;
  font-size: 44rpx;
  line-height: 1.45;
  font-weight: 800;
  margin: 16rpx 0 24rpx;
  word-break: break-word;
}
.home-title {
  font-size: 48rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.marker {
  background: linear-gradient(
    transparent 61%,
    #ffe16a 61%,
    #ffe16a 95%,
    transparent 95%
  );
  padding: 0 4rpx;
  box-decoration-break: clone;
}
.subtitle {
  font-size: 30rpx;
  color: #164565;
  font-weight: 750;
  margin-bottom: 10rpx;
}
.section-title {
  font-size: 32rpx;
  color: #164565;
  font-weight: 800;
  margin: 32rpx 0 18rpx;
}
.muted {
  color: #647b80;
  font-size: 25rpx;
}
.lead {
  margin-bottom: 24rpx;
}
.small {
  font-size: 22rpx;
}
.center {
  text-align: center;
}
.footnote {
  text-align: center;
  color: #8a948a;
  font-size: 21rpx;
  padding-top: 18rpx;
}
.card {
  box-sizing: border-box;
  background: #fffdf5;
  border: 2rpx solid #f0e8d8;
  border-radius: 28rpx;
  padding: 26rpx;
  margin: 22rpx 0;
  box-shadow: 0 3rpx 0 rgba(209, 197, 171, 0.12);
}
.hero {
  background: #fff2cd;
  border-color: #ffedba;
}
.purple {
  background: #efe8fb;
  border-color: #e8dff9;
}
.green {
  background: #edf8e5;
  border-color: #e0f0d4;
}
.blue {
  background: #e9f5ff;
  border-color: #dceefa;
}
.pink {
  background: #ffedf0;
  border-color: #fde1e7;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row > view + view {
  margin-left: 16rpx;
}
.row > button + button {
  margin-left: 14rpx;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.grid,
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.entry-card {
  box-sizing: border-box;
  width: 48%;
  border-radius: 25rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 14rpx;
}
.entry-card .subtitle {
  margin-top: 14rpx;
}
.entry-card .muted {
  font-size: 23rpx;
}
.stat {
  box-sizing: border-box;
  width: 48%;
  border-radius: 23rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
  background: #f2f8eb;
  text-align: center;
  border: 2rpx solid #e8f1de;
}
.stat:nth-child(4n + 2) {
  background: #edf7ff;
  border-color: #e1effa;
}
.stat:nth-child(4n + 3) {
  background: #fff5d9;
  border-color: #f8edc9;
}
.stat:nth-child(4n + 4) {
  background: #fff0f0;
  border-color: #f9e4e4;
}
.number {
  font-size: 42rpx;
  font-weight: 800;
  color: #267e50;
  line-height: 1.25;
  margin-bottom: 6rpx;
}
.mini-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  background: #fff0ad;
  color: #195275;
}
.blue-icon {
  background: #cceafd;
  color: #235a7c;
}
.green-icon {
  background: #cfebbe;
  color: #36865e;
}
.pink-icon {
  background: #ffd8de;
  color: #bc5a56;
}
.badge {
  display: inline-block;
  border-radius: 14rpx;
  background: #e1f0ce;
  color: #376a3e;
  font-size: 22rpx;
  font-weight: 650;
  padding: 5rpx 12rpx;
}
.tag {
  border-radius: 14rpx;
  background: #edf5e5;
  color: #44704b;
  font-size: 23rpx;
  padding: 9rpx 16rpx;
  margin: 6rpx 10rpx 6rpx 0;
  display: inline-block;
}
.tag.active {
  background: #42975a;
  color: #fff;
}
.bank-tab {
  flex: 1;
  min-width: 0;
  border-radius: 18rpx;
  background: #edf6ff;
  color: #36668b;
  font-size: 23rpx;
  font-weight: 700;
  padding: 18rpx 6rpx;
  margin: 6rpx 8rpx 16rpx 0;
  text-align: center;
  border: 3rpx solid transparent;
}
.bank-tab.mistake {
  background: #ffeaeb;
  color: #a95655;
}
.bank-tab.natural_upgrade {
  background: #e9f6e2;
  color: #47754b;
}
.bank-tab.active {
  border-color: currentColor;
}
.demo {
  font-size: 23rpx;
  color: #80672d;
  background: #fff8e4;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin: 20rpx 0;
  border: 1rpx dashed #eedb9e;
}
.demo-dot {
  color: #dca932;
  margin-right: 7rpx;
}
.empty {
  text-align: center;
  padding: 30rpx 16rpx;
  color: #71858a;
  font-size: 25rpx;
}
button {
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 750;
  border-radius: 24rpx;
  line-height: 1.5;
  padding: 22rpx 20rpx;
  margin: 16rpx 0;
  background: #fff1c7;
  color: #6f5b30;
  box-shadow: 0 4rpx 0 #eeddae;
}
button::after {
  border: 0;
}
button.primary {
  background: linear-gradient(180deg, #4fb260, #309946);
  color: #fff;
  box-shadow: 0 5rpx 0 #237535;
  border: 2rpx solid #3b9e4f;
}
button.secondary {
  background: #dff0fc;
  color: #205975;
  box-shadow: 0 4rpx 0 #c0deed;
}
button.danger {
  background: #ffe5e5;
  color: #aa4545;
  box-shadow: 0 4rpx 0 #efd0d0;
}
button[disabled] {
  opacity: 0.5;
}
.button-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
}
textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 230rpx;
  background: #fffefa;
  border: 2rpx solid #dce7d5;
  border-radius: 23rpx;
  padding: 22rpx;
  font-size: 29rpx;
  line-height: 1.65;
  margin: 18rpx 0;
  color: #174764;
}
input {
  background: #fffefa;
  border: 2rpx solid #dce7d5;
  border-radius: 20rpx;
  height: 84rpx;
  padding: 0 20rpx;
  margin: 16rpx 0;
  color: #174764;
}
.label {
  font-size: 25rpx;
  color: #647b80;
  margin-top: 20rpx;
}
.english {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-word;
  color: #174764;
}
.text {
  white-space: pre-wrap;
  word-break: break-word;
}
.line {
  border-bottom: 1rpx solid #e7ecdf;
  padding: 16rpx 0;
}
.map {
  display: flex;
  flex-wrap: wrap;
}
.node {
  font-size: 23rpx;
  background: #eff3e8;
  color: #6b836e;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  margin: 6rpx 8rpx 6rpx 0;
}
.node.active {
  background: #ffe16a;
  color: #244e37;
  font-weight: 750;
}
.node.done {
  background: #dcefcf;
  color: #3d7750;
}
.error {
  background: #ffe5e2;
  color: #a14b34;
  padding: 18rpx;
  border-radius: 18rpx;
}
.link {
  color: #25804c;
  font-weight: 700;
}
.spacer {
  height: 20rpx;
}
checkbox {
  transform: scale(0.85);
}
.candidate {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e6eddf;
}
.candidate > view {
  margin-left: 10rpx;
}

/* C 方案：轻量卡片，不使用整页纸张或装订装饰。 */
page {background:#fff7ee;color:#24465c;background-image:linear-gradient(180deg,#ffe1c5 0,#fff7ee 520rpx);}
.title {color:#24465c;font-weight:750;letter-spacing:0;}
.marker {background:none;padding:0;}
.card {background:#fff;border:1rpx solid #f4eee5;box-shadow:0 8rpx 26rpx rgba(91,71,45,.04);border-radius:28rpx;padding:28rpx;margin:22rpx 0;}
.hero {background:#ffe7cf;border-color:#fff;}
.green {background:#edf5e8;border-color:#e5f0dd;}
.blue {background:#f2f7fc;border-color:#eaf0f5;}
.pink {background:#fff0ee;border-color:#f9e6e2;}
button {border-radius:50rpx;box-shadow:none;font-weight:650;}
button.primary {background:linear-gradient(180deg,#67aa6c,#52935d);border:0;box-shadow:0 6rpx 16rpx rgba(66,126,75,.12);}
button.secondary {background:#edf3ed;color:#42764d;box-shadow:none;}
.badge {border-radius:10rpx;font-size:21rpx;font-weight:600;background:#e9f3dd;}
.subtitle {font-weight:700;}

/* Full-height Scheme C background, including custom navigation and status bar. */
page {
  background-color: #fffaf3;
  background-image: linear-gradient(145deg, rgba(255,225,196,.46) 0%, rgba(255,245,230,.2) 26%, transparent 26%), linear-gradient(155deg, transparent 8%, rgba(255,232,207,.35) 8%, rgba(255,232,207,.35) 18%, transparent 18%), linear-gradient(180deg, #fff9f1, #fffaf5);
}
