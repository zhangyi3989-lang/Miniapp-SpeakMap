<view class="page">
  <brand-header section="详细学习"/>
  <view class="badge">{{mother.id}} · {{mother.category}}</view>
  <view class="title">{{mother.skeleton}}</view>
  <view class="muted small">母句学习资料 · 按原文整理。资料中的训练阶段说明不改变当前小程序 L1–L6 流程。</view>
  <view class="lesson-content">
    <view wx:for="{{blocks}}" wx:key="index" class="lesson-block lesson-{{item.type}}">{{item.type === 'rule' ? '' : item.text}}</view>
  </view>
  <button class="primary" bindtap="start">开始今天的学习 →</button>
</view>
