.lesson-note {
  font-size: 26rpx;
  margin-top: 16rpx;
  line-height: 1.8;
}
.slot-card {
  padding: 20rpx;
  border-radius: 22rpx;
  margin: 12rpx 0;
}
.slot-number {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  background: #fffefa;
  border-radius: 50%;
  font-weight: 800;
  color: #3d7950;
  flex-shrink: 0;
}
.slot-card .subtitle {
  font-size: 27rpx;
  margin-bottom: 4rpx;
}
.slot-card .english {
  font-size: 30rpx;
}
.thought {
  background: #fffefb;
  padding: 14rpx 18rpx;
  border-radius: 15rpx;
  font-weight: 700;
}
.worked {
  margin-top: 22rpx;
}
.translation {
  margin: 8rpx 0 16rpx;
  font-size: 27rpx;
  color: #4d6e66;
}
.wrong {
  color: #a05248;
  margin-bottom: 10rpx;
  font-size: 25rpx;
}
.check-option {
  background: #fffefa;
  color: #174764;
  border: 2rpx solid #e8debf;
  box-shadow: none;
  text-align: left;
  font-size: 26rpx;
  font-weight: 500;
}
.check-option.chosen {
  border-color: #409353;
  background: #edf8e5;
}
.check-explanation {
  padding-top: 18rpx;
  border-top: 2rpx dashed #dfcd8c;
}
