<brand-header back="{{true}}"/>
<view class="page">

  <view class="title"><text class="marker">12个功能表达</text></view>
  <view class="muted">从切入话题到补充、解释和收尾，让表达自然连起来。</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="badge">{{item.id}}</view>
    <view class="subtitle">{{item.name}}</view>
    <view class="muted">什么时候用：{{item.action}}</view>
    <view class="label">主动掌握</view>
    <view wx:for="{{item.primary}}" wx:for-item="expression" wx:key="*this" class="line english">{{expression}}</view>
    <view wx:if="{{item.supporting.length}}" class="label">辅助 / 认识即可</view>
    <view wx:for="{{item.supporting}}" wx:for-item="expression" wx:key="*this" class="line">{{expression}}</view>
  </view>
</view>
