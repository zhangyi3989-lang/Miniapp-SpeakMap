<view class="page">
  <view class="brand">
    <view class="logo">S</view>
    SpeakMap
  </view>
  <view class="eyebrow">THINK · RECALL · SPEAK</view>
  <view class="title">
    <view>把学过的英语，</view>
    <view>真正调出来。</view>
  </view>
  <view wx:if="{{demo}}" class="demo">当前为示例模式 · 文字训练 · 数据仅保存在当前设备</view>
  <view class="card hero">
    <view class="subtitle">一次，只练好眼前这一题</view>
    <view class="muted">不用决定学什么。从上次停下的地方继续。</view>
    <button class="primary" bindtap="start">开始今天的学习 →</button>
  </view>
  <view wx:if="{{active}}" class="card purple">
    <view class="subtitle">还有一段表达，等你继续</view>
    <view class="muted">
      {{active.motherSentenceId || '自由表达 / 复习'}} · {{active.phase === 'phase0' ? 'Phase 0' : active.level}} · 第
      {{active.itemIndex + 1}} 题
    </view>
    <button class="secondary" bindtap="continue">继续上次训练</button>
  </view>
  <view class="grid">
    <view class="stat" bindtap="mothers">
      <view class="subtitle">母句训练 ↗</view>
      <view class="muted">把意思变成自己的话</view>
    </view>
    <view class="stat" bindtap="free">
      <view class="subtitle">自由表达 ↗</view>
      <view class="muted">从一个真实话题开始</view>
    </view>
  </view>
  <view class="card green" bindtap="reviews">
    <view class="row">
      <view>今日到期复习</view>
      <view class="number">{{stats.due}}</view>
    </view>
    <view class="muted">{{stats.due ? '先回忆，再看参考。' : '今天没有到期复习。'}}</view>
  </view>
  <view class="grid">
    <view class="stat">
      <view class="number">{{stats.started}}</view>
      <view class="muted">已训练母句</view>
    </view>
    <view class="stat">
      <view class="number">{{stats.answers}}</view>
      <view class="muted">累计回答</view>
    </view>
    <view class="stat">
      <view class="number">{{stats.days}}</view>
      <view class="muted">训练天数</view>
    </view>
    <view class="stat">
      <view class="number">{{stats.stages}}</view>
      <view class="muted">完成训练阶段</view>
    </view>
  </view>
  <view wx:if="{{!stats.answers}}" class="empty">第一次练习，就从一句自己的话开始。</view>
</view>
