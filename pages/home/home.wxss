page {
  background: #fff9f1;
}
.home-page {
  position: relative;
  padding: 0 24rpx 32rpx;
  margin: 0;
  max-width: none;
}
.home-scene {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 490rpx;
  z-index: 0;
}
.home-header,
.home-welcome,
.current-card,
.route-card,
.content-entries,
.demo,
.footnote {
  position: relative;
  z-index: 1;
}
.home-header {
  height: 120rpx;
  box-sizing: border-box;
  padding: 46rpx 16rpx 0;
}
.home-logo {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #24465c;
}
.home-logo text {
  color: #58945a;
}
.home-tagline {
  font-size: 20rpx;
  color: #7b8a88;
  margin-left: 36rpx;
  margin-top: 5rpx;
}
.home-welcome {
  height: 214rpx;
  box-sizing: border-box;
  padding: 56rpx 12rpx 0;
}
.welcome-title {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: 800;
  letter-spacing: 1rpx;
  color: #24465c;
}
.welcome-line {
  font-size: 23rpx;
  color: #728587;
  margin-top: 16rpx;
  max-width: 480rpx;
}
.current-card {
  border: 6rpx solid #fff;
  border-radius: 32rpx;
  background: linear-gradient(125deg, #fff0dd, #ffe0c5);
  padding: 28rpx 32rpx 24rpx;
  margin: 0 0 20rpx;
  box-shadow: 0 10rpx 25rpx rgba(100, 76, 42, 0.045);
}
.current-main {
  display: flex;
  align-items: center;
  min-height: 170rpx;
  position: relative;
}
.current-copy {
  flex: 1;
  min-width: 0;
  padding-right: 124rpx;
}
.reading-cat {
  position: absolute;
  right: -6rpx;
  bottom: -10rpx;
  width: 178rpx;
  height: 178rpx;
}
.current-title {
  font-size: 33rpx;
  line-height: 1.4;
  font-weight: 750;
  margin: 20rpx 0 12rpx;
  color: #24465c;
}
.current-description {
  font-size: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.home-page .current-card button.primary {
  width: 100%;
  max-width: none;
  margin: 20rpx 0 0;
  padding: 22rpx 10rpx;
  line-height: 1.4;
  border-radius: 60rpx;
  font-size: 29rpx;
  box-shadow: none;
}
.route-card {
  padding: 24rpx 28rpx;
  margin: 0 0 18rpx;
  border: 0;
  border-radius: 30rpx;
}
.route-heading {
  margin-bottom: 8rpx;
}
.route-heading .subtitle {
  font-size: 29rpx;
  margin: 0;
}
.plan-toggle {
  color: #8a9599;
  font-size: 23rpx;
  padding: 8rpx 0 8rpx 16rpx;
}
.route-step {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
}
.route-step + .route-step .grow {
  border-top: 1rpx solid #eef0eb;
  padding-top: 18rpx;
  margin-top: -18rpx;
}
.route-number {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  line-height: 48rpx;
  text-align: center;
  background: #eef0f1;
  color: #637981;
  font-size: 25rpx;
  z-index: 1;
}
.route-step:not(:last-child):before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 66rpx;
  bottom: -20rpx;
  border-left: 2rpx dashed #d2d7d6;
}
.route-number.review {
  background: #ffdfc5;
  color: #a76844;
}
.route-number.new {
  background: #e4efdc;
  color: #55865e;
}
.plan-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #24465c;
}
.route-description {
  font-size: 21rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.next-label {
  font-size: 21rpx;
  color: #57995f;
  white-space: nowrap;
  margin-left: 6rpx;
  padding-top: 8rpx;
}
.more-note,
.route-note {
  font-size: 20rpx;
  margin-top: 8rpx;
}
.content-entries {
  display: flex;
  gap: 16rpx;
  flex-wrap: nowrap;
  margin: 0;
}
.content-entries .entry-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 50%;
  min-height: 146rpx;
  margin: 0;
  padding: 22rpx 18rpx;
  border: 4rpx solid #fff;
  border-radius: 27rpx;
}
.resource-mothers {
  background: #eaf4e3;
}
.resource-functions {
  background: #fff2d0;
}
.content-entries .subtitle {
  font-size: 24rpx;
  margin: 0 0 5rpx;
  white-space: nowrap;
}
.content-entries .small {
  font-size: 20rpx;
  white-space: nowrap;
}
.resource-icon {
  flex-shrink: 0;
  color: #548459;
}
.book-icon {
  display: flex;
  width: 48rpx;
  height: 42rpx;
}
.book-icon view {
  width: 24rpx;
  height: 36rpx;
  border: 3rpx solid #548459;
  border-radius: 7rpx 7rpx 2rpx 2rpx;
}
.bubble-icon {
  width: 45rpx;
  height: 37rpx;
  border: 3rpx solid #c3963c;
  border-radius: 50%;
  color: #c3963c;
  font-size: 31rpx;
  line-height: 18rpx;
  text-align: center;
}
.entry-arrow {
  font-size: 34rpx;
  color: #8c9a8d;
}
.home-page .demo {
  padding: 12rpx 16rpx;
  margin-top: 20rpx;
}

/* C 参考图统一图标、字阶和颜色。 */
.home-page {
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  color: #173f59;
}
.home-logo {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 750;
  color: #123b57;
  gap: 10rpx;
}
.logo-leaf {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}
.logo-leaf.trailing {
  width: 28rpx;
  height: 28rpx;
}
.home-tagline {
  font-size: 23rpx;
  margin-top: 6rpx;
  color: #7c8c91;
}
.welcome-title {
  font-size: 52rpx;
  letter-spacing: 0;
  font-weight: 750;
  color: #153b55;
}
.welcome-line {
  font-size: 25rpx;
  color: #7d8d91;
}
.current-card {
  border-radius: 34rpx;
  background: linear-gradient(125deg, #fff0dc, #fce0c7);
  box-shadow: 0 8rpx 24rpx rgba(139, 104, 61, 0.04);
}
.current-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #173f59;
}
.current-description {
  font-size: 26rpx;
  color: #7b8e91;
}
.current-card .badge {
  font-size: 23rpx;
  color: #6b8b58;
  background: #e6eccb;
  padding: 5rpx 14rpx;
  border-radius: 10rpx;
}
.home-page .current-card button.primary {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 26rpx;
  background: linear-gradient(120deg, #679e6c, #72ab76);
  font-size: 32rpx;
  font-weight: 500;
  min-height: 88rpx;
  padding: 20rpx 12rpx;
}
.cta-arrow {
  width: 36rpx;
  height: 36rpx;
}
.route-heading .subtitle {
  font-size: 30rpx;
  color: #173f59;
  font-weight: 650;
}
.plan-title {
  font-size: 27rpx;
  color: #173f59;
  font-weight: 650;
}
.route-description {
  font-size: 23rpx;
  color: #8a979c;
}
.route-number {
  font-size: 29rpx;
  color: #23475c;
  background: #eef0f1;
}
.route-number.review {
  color: #8b5b34;
  background: #fce0c8;
}
.plan-toggle {
  font-size: 24rpx;
  color: #8c979d;
}
.next-label {
  font-size: 24rpx;
  color: #68a16d;
}
.due-chip {
  display: inline-block;
  padding: 0 8rpx;
  margin-left: 10rpx;
  border-radius: 6rpx;
  color: #c68357;
  background: #fff0df;
  font-size: 20rpx;
  font-weight: 550;
}
.resource-icon {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}
.content-entries .entry-card {
  width: calc((100% - 16rpx) / 2);
  gap: 14rpx;
  min-height: 170rpx;
}
.resource-mothers {
  background: linear-gradient(120deg, #eef6e9, #e5f1df);
}
.resource-functions {
  background: linear-gradient(120deg, #fff8df, #fff1c8);
}
.content-entries .subtitle {
  font-size: 26rpx;
  color: #173f59;
  font-weight: 650;
}
.content-entries .small {
  font-size: 22rpx;
  color: #91a090;
}
.entry-arrow {
  width: 20rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.home-bell {
  position: absolute;
  right: 18rpx;
  bottom: 12rpx;
  width: 38rpx;
  height: 38rpx;
  padding: 8rpx;
}

/* 微信原生 image 默认尺寸较大，图标与按钮尺寸在模板中同步约束。 */
.home-page .current-card button.primary {
  height: 88rpx;
  max-height: 88rpx;
  overflow: hidden;
  box-sizing: border-box;
}
