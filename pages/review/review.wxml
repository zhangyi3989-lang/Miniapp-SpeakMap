<view class="page review-page">
  <view wx:if="{{!session}}" class="review-overview">
    <view class="title"><text class="marker">学习库复习</text></view>
    <view class="muted">先想起来，再换个场景用出来。</view>
    <view wx:for="{{categories}}" wx:key="type" class="card review-category {{item.type}}" data-type="{{item.type}}" bindtap="selectBank">
      <view class="review-category-top"><view class="review-icon"><image src="/assets/ui-{{item.type === 'mistake' ? 'mistake' : item.type === 'natural_upgrade' ? 'upgrade' : 'chunk'}}.png" mode="aspectFit" style="width:66rpx;height:66rpx;"/></view><view class="grow"><view class="subtitle">{{item.name}}</view><view class="small muted">{{item.description}}</view></view></view>
      <view class="review-category-bottom"><view class="due-metric"><text>{{item.due}}</text> 条<view class="small muted">今日待复习</view></view><view class="accumulated small muted">已积累 <text>{{item.total}}</text> 条</view><button class="primary review-start" data-type="{{item.type}}" catchtap="startBank">{{item.due ? '开始复习' : '查看安排'}}<image src="/assets/home-arrow.png" mode="aspectFit" style="width:28rpx;height:28rpx;flex-shrink:0;"/></button></view>
    </view>
    <block wx:if="{{selectedType}}">
      <view class="subtitle">所选学习库的复习安排</view>
      <view wx:for="{{items}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}">
        <view class="row"><view class="badge">R{{item.stage+1}}</view><view class="muted">{{item.isDue ? '到期，开始 →' : item.date + ' 到期'}}</view></view>
        <view class="subtitle">学习库条目（参考在回忆后显示）</view>
      </view>
      <view wx:if="{{!items.length}}" class="empty">暂无待安排的条目。加入这个学习库后，会自动安排复习。</view>
    </block>
  </view>
  <block wx:else>
    <view class="badge">R{{stage+1}} / R5 · {{task.name}}</view>
    <view class="title">{{task.prompt}}</view>
    <view wx:if="{{!session.revealed}}" class="muted">先自己想一想，再查看参考。</view>
    <textarea
      value="{{input}}"
      maxlength="{{max}}"
      bindinput="input"
      disabled="{{session.revealed}}"
      placeholder="写下你想起来的表达。"
    />
    <button wx:if="{{!session.revealed}}" class="primary" bindtap="reveal">保存回忆，查看参考</button>
    <block wx:if="{{session.revealed}}">
      <view class="card purple">
        <view class="label">参考表达（不是对你输入的判断）</view>
        <view class="english">{{task.reference}}</view>
      </view>
      <view class="label">换场景造句（可选，只保存，不评分）</view>
      <textarea value="{{scene}}" maxlength="{{max}}" bindinput="scene" placeholder="换一个自己的新场景。" />
      <view class="row">
        <button class="primary grow" data-recalled="yes" bindtap="rate" disabled="{{busy}}">想起来了</button>
        <button class="secondary grow" data-recalled="no" bindtap="rate" disabled="{{busy}}">还需要复习</button>
      </view>
      <view class="muted">想起来了：进入下一阶段；还需要复习：次日再试。完成 R5 只表示完成复习周期。</view>
    </block>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </block>
</view>
