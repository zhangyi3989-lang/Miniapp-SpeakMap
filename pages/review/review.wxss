/* Scheme C: explicit page styles also override older app.wxss spacing. */
page {
  background: #fff8f0;
  background-image: linear-gradient(180deg, #fff0df 0, #fff8f0 300rpx);
  color: #203f56;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.55;
}
.page.review-page {
  box-sizing: border-box;
  width: 100%;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 6rpx 28rpx 44rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.review-page .title {
  color: #203f56;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
}
.review-page .subtitle { color: #203f56; font-weight: 600; }
.review-page .muted { color: #859397; font-size: 24rpx; line-height: 1.55; }
.review-page .small.muted { font-size: 22rpx; }
.review-page .marker { background: none; padding: 0; }
.review-page .card { background: #ffffff; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(91, 71, 45, 0.035); }
.review-page button.primary {
  background: linear-gradient(180deg, #77aa79, #629968);
  color: #ffffff;
  border: 0;
}

.review-page .title {
  margin: 0 0 8rpx;
  font-size: 44rpx;
}
.review-category {
  margin: 22rpx 0;
  padding: 24rpx;
  border: 0;
}
.review-category-top {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.review-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 20rpx;
  background: #ffe8db;
  flex-shrink: 0;
}
.natural_upgrade .review-icon {
  background: #e7f2de;
}
.expression .review-icon {
  background: #e1effc;
}
.review-category .subtitle {
  font-size: 29rpx;
  margin-bottom: 4rpx;
}
.review-category-bottom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}
.due-metric {
  min-width: 120rpx;
  font-size: 22rpx;
}
.due-metric text {
  font-size: 38rpx;
  font-weight: 700;
}
.accumulated {
  border-left: 1rpx solid #e5e9e7;
  padding-left: 18rpx;
  flex: 1;
  font-size: 21rpx;
}
.review-start.primary {
  width: auto;
  flex-shrink: 0;
  margin: 0;
  padding: 15rpx 20rpx;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.4;
  box-shadow: none;
}
