/* Scheme C layout: native navigation remains outside this content area. */
page {
  background-color: #fffaf3;
  background-image: linear-gradient(145deg, rgba(255,225,196,.46) 0%, rgba(255,245,230,.2) 26%, transparent 26%), linear-gradient(155deg, transparent 8%, rgba(255,232,207,.35) 8%, rgba(255,232,207,.35) 18%, transparent 18%), linear-gradient(180deg, #fff9f1, #fffaf5);
  color: #102f49;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page.review-page { box-sizing: border-box; width: 100%; max-width: 900rpx; margin: 0 auto; padding: 8rpx 30rpx 34rpx; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.review-page .title { margin: 0 0 8rpx; color: #0c2e49; font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0; }
.review-page .subtitle { color: #0c2e49; font-size: 32rpx; font-weight: 600; line-height: 1.4; margin: 0; }
.review-page .muted { color: #62778d; font-size: 26rpx; line-height: 1.5; }
.review-page .small.muted { font-size: 24rpx; }
.review-page .marker { padding: 0; background: none; }
.review-page .card { box-sizing: border-box; background: #fff; border: 1rpx solid #f1ede7; border-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(112,85,47,.045); }
.review-page .row { display: flex; justify-content: space-between; align-items: center; }
.review-page button.primary { background: linear-gradient(180deg, #65aa75, #559969); color: #fff; border: 0; border-radius: 50rpx; font-weight: 500; box-shadow: none; }
.review-page button.primary::after { border: 0; }
.review-page .empty { margin: 24rpx 0; padding: 36rpx 24rpx; border-radius: 28rpx; color: #62778d; background: rgba(255,255,255,.78); font-size: 25rpx; }

.review-overview > .muted { margin-bottom: 32rpx; }
.review-page .review-category { margin: 0 0 26rpx; padding: 26rpx; }
.review-category-top { display: flex; align-items: center; gap: 28rpx; }
.review-icon { display: flex; align-items: center; justify-content: center; width: 122rpx; height: 122rpx; border-radius: 24rpx; background: linear-gradient(145deg,#ffe4d9,#fff0e8); flex-shrink: 0; }
.natural_upgrade .review-icon { background: linear-gradient(145deg,#e0efd9,#f0f7eb); }
.expression .review-icon { background: linear-gradient(145deg,#d5e8ff,#e3f1ff); }
.review-category .subtitle { font-size: 34rpx; margin-bottom: 8rpx; }
.review-category .small.muted { font-size: 24rpx; }
.review-category-bottom { display: flex; align-items: center; gap: 22rpx; margin-top: 28rpx; }
.due-metric { min-width: 162rpx; font-size: 23rpx; color: #102f49; line-height: 1.3; }
.due-metric text { font-size: 52rpx; font-weight: 600; margin-right: 6rpx; }
.due-metric .small { margin-top: 2rpx; }
.accumulated { border-left: 1rpx solid #dce3e9; padding-left: 28rpx; flex: 1; white-space: nowrap; }
.accumulated text { font-size: 36rpx; font-weight: 600; }
.review-page .review-start.primary { display: flex; align-items: center; justify-content: center; gap: 12rpx; box-sizing: border-box; width: 232rpx; height: 88rpx; flex-shrink: 0; margin: 0; padding: 0 20rpx; font-size: 27rpx; font-weight: 500; line-height: 1.4; }
