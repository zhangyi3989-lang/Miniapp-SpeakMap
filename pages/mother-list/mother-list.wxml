<view class="page"><brand-header section="母句"/>
  <view class="eyebrow">YOUR LANGUAGE MAP</view>
  <view class="title"><text class="marker">34个母句</text></view>
  <view class="muted">先理解核心意思，再主动调取。当前已收录3个母句，完整34个内容待补充。</view>
  <view wx:for="{{items}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}">
    <view class="row">
      <view class="badge">{{item.id}}</view>
      <view class="muted">{{item.status}} →</view>
    </view>
    <view class="english">{{item.skeleton}}</view>
    <view class="muted">{{item.meaning}}</view>
  </view>
</view>
