<view class="page profile-page">
  <view class="profile-heading"><view class="grow"><view class="title">我的学习足迹</view><view class="muted small">每一次学习都是靠近更好的你</view></view><image class="profile-cat" src="/assets/c-profile-cat.png" mode="aspectFit" style="width:210rpx;height:176rpx;"/></view>
  <view class="card summary-card" bindtap="toggleDetails"><view class="summary-metric"><view class="metric-number">{{stats.days}}</view><view>训练天数</view></view><view class="summary-metric"><view class="metric-number">{{stats.answers}}</view><view>累计回答</view></view><view class="summary-metric"><view class="metric-number">{{stats.completed}}</view><view>完成母句</view></view></view>

  <view wx:if="{{detailsOpen}}" class="card small muted">已开始母句 {{stats.started}} · 复习 {{stats.reviews}} 次 · 学习库 {{stats.banks}} 条</view>
  <view class="row"><view class="section-title">最近训练</view><view class="small muted" bindtap="toggleRecords">{{recordsOpen ? '收起' : '查看全部'}} ›</view></view>
  <view class="record-timeline"><view wx:for="{{recordsOpen ? records : recentRecords}}" wx:key="sessionId" class="record-entry" data-id="{{item.sessionId}}" bindtap="record"><view class="record-date">{{item.date}}</view><view class="card record-card"><view class="record-icon {{item.sessionType === 'review' ? 'is-review' : ''}}"><image src="{{item.sessionType === 'review' ? '/assets/c-repeat.png' : '/assets/ui-record.png'}}" mode="aspectFit" style="width:44rpx;height:44rpx;"/></view><view class="grow"><view class="record-title-row"><view class="record-title">{{item.label}}</view><view class="saved-label">已保存</view></view><view class="small muted">{{item.answerCount}} 条回答 · {{item.completed ? '本次练习已完成' : '进度已保存'}}</view></view><image src="/assets/c-chevron.png" mode="aspectFit" style="width:18rpx;height:24rpx;flex-shrink:0;"/></view></view></view>
  <view wx:if="{{!records.length}}" class="empty">还没有训练记录，从今天的学习开始吧。</view>
  <view class="card utility-card" bindtap="backup"><image src="/assets/ui-backup.png" mode="aspectFit" style="width:42rpx;height:42rpx;flex-shrink:0;"/><view class="grow"><view class="subtitle">数据备份</view><view class="small muted">保障你的学习数据安全</view></view><image src="/assets/c-chevron.png" mode="aspectFit" style="width:18rpx;height:24rpx;flex-shrink:0;"/></view>
  <view class="footnote">学习数据保存在当前设备</view>
</view>
