/* Scheme C: explicit page styles also override older app.wxss spacing. */
page {
  background: #fff8f0;
  background-image: linear-gradient(180deg, #fff0df 0, #fff8f0 300rpx);
  color: #203f56;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.55;
}
.page.profile-page {
  box-sizing: border-box;
  width: 100%;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 6rpx 28rpx 44rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.profile-page .title {
  color: #203f56;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
}
.profile-page .subtitle { color: #203f56; font-weight: 600; }
.profile-page .muted { color: #859397; font-size: 24rpx; line-height: 1.55; }
.profile-page .small.muted { font-size: 22rpx; }
.profile-page .marker { background: none; padding: 0; }
.profile-page .card { background: #ffffff; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(91, 71, 45, 0.035); }
.profile-page button.primary {
  background: linear-gradient(180deg, #77aa79, #629968);
  color: #ffffff;
  border: 0;
}

.profile-heading {
  display: flex;
  align-items: center;
  margin: 0 0 10rpx;
}
.profile-heading .title {
  font-size: 44rpx;
  margin: 0 0 10rpx;
}
.summary-card {
  display: flex;
  padding: 28rpx 12rpx;
  border: 0;
  margin: 12rpx 0;
}
.summary-metric {
  flex: 1;
  text-align: center;
  font-size: 23rpx;
  color: #819397;
}
.summary-metric + .summary-metric {
  border-left: 1rpx solid #e7ede7;
}
.metric-number {
  color: #173f59;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 6rpx;
}
.extra-stats {
  padding: 4rpx 8rpx;
}
.section-title {
  font-size: 29rpx;
  margin: 28rpx 0 18rpx;
}
.record-timeline {
  padding-left: 16rpx;
}
.record-entry {
  position: relative;
  border-left: 2rpx solid #e3e9e0;
  padding: 0 0 20rpx 28rpx;
}
.record-entry:before {
  content: "";
  position: absolute;
  left: -8rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #75a875;
}
.record-entry:nth-child(even):before {
  background: #f4ac80;
}
.record-date {
  font-size: 23rpx;
  color: #87999c;
  margin-bottom: 10rpx;
}
.record-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0;
  border: 0;
  padding: 20rpx 16rpx;
}
.record-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ebf4e4;
  flex-shrink: 0;
}
.record-title {
  font-size: 25rpx;
  font-weight: 600;
}
.saved-label {
  background: #eaf4e3;
  color: #4c8055;
  border-radius: 20rpx;
  padding: 3rpx 12rpx;
  font-size: 20rpx;
  white-space: nowrap;
}
.utility-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 0;
  padding: 24rpx;
  margin: 22rpx 0;
}
.utility-card .subtitle {
  font-size: 26rpx;
  margin-bottom: 2rpx;
}
