/* Scheme C layout: native navigation remains outside this content area. */
page {
  background-color: #fffaf3;
  background-image: linear-gradient(145deg, rgba(255,225,196,.46) 0%, rgba(255,245,230,.2) 26%, transparent 26%), linear-gradient(155deg, transparent 8%, rgba(255,232,207,.35) 8%, rgba(255,232,207,.35) 18%, transparent 18%), linear-gradient(180deg, #fff9f1, #fffaf5);
  color: #102f49;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page.profile-page { box-sizing: border-box; width: 100%; max-width: 900rpx; margin: 0 auto; padding: 8rpx 30rpx 34rpx; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.profile-page .title { margin: 0 0 8rpx; color: #0c2e49; font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0; }
.profile-page .subtitle { color: #0c2e49; font-size: 32rpx; font-weight: 600; line-height: 1.4; margin: 0; }
.profile-page .muted { color: #62778d; font-size: 26rpx; line-height: 1.5; }
.profile-page .small.muted { font-size: 24rpx; }
.profile-page .marker { padding: 0; background: none; }
.profile-page .card { box-sizing: border-box; background: #fff; border: 1rpx solid #f1ede7; border-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(112,85,47,.045); }
.profile-page .row { display: flex; justify-content: space-between; align-items: center; }
.profile-page button.primary { background: linear-gradient(180deg, #65aa75, #559969); color: #fff; border: 0; border-radius: 50rpx; font-weight: 500; box-shadow: none; }
.profile-page button.primary::after { border: 0; }
.profile-page .empty { margin: 24rpx 0; padding: 36rpx 24rpx; border-radius: 28rpx; color: #62778d; background: rgba(255,255,255,.78); font-size: 25rpx; }

.profile-heading { position: relative; display: flex; align-items: center; min-height: 176rpx; margin: 0; }
.profile-heading:before { content: ""; position: absolute; right: -30rpx; top: -42rpx; width: 360rpx; height: 300rpx; border-radius: 60% 0 0 60%; background: linear-gradient(145deg,rgba(255,222,186,.66),rgba(255,241,219,.26)); }
.profile-heading .grow { position: relative; z-index: 1; padding-right: 174rpx; }
.profile-heading .title { font-size: 44rpx; white-space: nowrap; }
.profile-heading .small.muted { font-size: 24rpx; white-space: nowrap; }
.profile-cat { position: absolute; right: -12rpx; top: 0; bottom: auto; z-index: 0; }
.profile-page .summary-card { position: relative; display: flex; align-items: center; padding: 34rpx 14rpx; margin: 0 0 32rpx; }
.summary-metric { flex: 1; text-align: center; font-size: 26rpx; color: #62778d; line-height: 1.4; }
.summary-metric + .summary-metric { border-left: 1rpx solid #e1e6eb; }
.metric-number { color: #10324c; font-size: 62rpx; font-weight: 600; line-height: 1.25; margin-bottom: 8rpx; }
.extra-stats { padding: 0 6rpx 16rpx; }
.section-title { color: #0c2e49; font-weight: 600; font-size: 34rpx; margin: 8rpx 0 24rpx; }
.record-timeline { padding-left: 28rpx; }
.record-entry { position: relative; border-left: 2rpx solid #d8dcd6; padding: 0 0 32rpx 32rpx; }
.record-entry:last-child { padding-bottom: 0; }
.record-entry:before { content: ""; position: absolute; left: -11rpx; top: 8rpx; width: 20rpx; height: 20rpx; border: 2rpx solid #fffaf3; border-radius: 50%; background: #68a874; }
.record-entry:nth-child(even):before { background: #ffab7d; }
.record-date { font-size: 26rpx; color: #657b95; margin-bottom: 14rpx; }
.profile-page .record-card { position: relative; display: flex; align-items: center; gap: 22rpx; margin: 0; padding: 24rpx 20rpx; }
.record-icon { width: 82rpx; height: 82rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: #eaf4e3; flex-shrink: 0; }
.record-icon.is-review { background: #ffe7d1; }
.record-title-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-bottom: 8rpx; }
.record-title { color: #102e48; font-size: 27rpx; font-weight: 500; }
.record-card .small.muted { font-size: 22rpx; }
.saved-label { background: #e8f3e5; color: #357945; border-radius: 24rpx; padding: 4rpx 16rpx; font-size: 21rpx; white-space: nowrap; flex-shrink: 0; }
.profile-page .utility-card { display: flex; align-items: center; gap: 28rpx; padding: 28rpx; margin: 34rpx 0 16rpx; }
.utility-card .subtitle { font-size: 28rpx; margin-bottom: 6rpx; }
.utility-card .small.muted { font-size: 23rpx; }
.profile-page .footnote { font-size: 21rpx; color: #8897a3; text-align: center; }
