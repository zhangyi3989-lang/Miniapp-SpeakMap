<view class="page">
  <view class="eyebrow">KEEP · RECALL · USE</view>
  <view class="title">我的学习库</view>
  <view class="map">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tag {{type === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="tab"
    >
      {{item.name}}
    </view>
  </view>
  <view class="muted">
    {{type === 'expression' ? '值得整体调用的新表达。' : type === 'mistake' ? '真实错误与示例候选会明确区分。' : '原表达可成立时，更自然的说法。'}}
  </view>
  <input placeholder="搜索表达文字" value="{{query}}" bindinput="search" />
  <picker range="{{motherOptions}}" value="{{filter}}" bindchange="filter">
    <view class="tag">按母句：{{motherOptions[filter]}} ▾</view>
  </picker>
  <view wx:for="{{items}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}">
    <view class="row">
      <view class="badge">
        {{item.provenance === 'demo_reference' ? '示例内容' : '学习内容'}} · {{item.sourceMotherSentenceId || '自由表达'}}
      </view>
      <view class="small muted">R{{item.reviewStage+1}}</view>
    </view>
    <view class="english">{{item.text}}</view>
    <view class="muted">{{item.meaning}}</view>
    <view class="small muted">下次复习：{{item.date}}</view>
  </view>
  <view wx:if="{{!items.length}}" class="empty">
    {{query || filter ? '没有找到匹配内容。' : '学习库还是空的。完成训练后，勾选你想留下的表达。'}}
  </view>
</view>
