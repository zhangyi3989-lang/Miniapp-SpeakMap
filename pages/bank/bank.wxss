/* Scheme C layout: native navigation remains outside this content area. */
page {
  background-color: #fffaf3;
  background-image: linear-gradient(145deg, rgba(255,225,196,.46) 0%, rgba(255,245,230,.2) 26%, transparent 26%), linear-gradient(155deg, transparent 8%, rgba(255,232,207,.35) 8%, rgba(255,232,207,.35) 18%, transparent 18%), linear-gradient(180deg, #fff9f1, #fffaf5);
  color: #102f49;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page.catalog-page { box-sizing: border-box; width: 100%; max-width: 900rpx; margin: 0 auto; padding: 8rpx 30rpx 34rpx; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.catalog-page .title { margin: 0 0 8rpx; color: #0c2e49; font-size: 48rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0; }
.catalog-page .subtitle { color: #0c2e49; font-size: 32rpx; font-weight: 600; line-height: 1.4; margin: 0; }
.catalog-page .muted { color: #62778d; font-size: 26rpx; line-height: 1.5; }
.catalog-page .small.muted { font-size: 24rpx; }
.catalog-page .marker { padding: 0; background: none; }
.catalog-page .card { box-sizing: border-box; background: #fff; border: 1rpx solid #f1ede7; border-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(112,85,47,.045); }
.catalog-page .row { display: flex; justify-content: space-between; align-items: center; }
.catalog-page button.primary { background: linear-gradient(180deg, #65aa75, #559969); color: #fff; border: 0; border-radius: 50rpx; font-weight: 500; box-shadow: none; }
.catalog-page button.primary::after { border: 0; }
.catalog-page .empty { margin: 24rpx 0; padding: 36rpx 24rpx; border-radius: 28rpx; color: #62778d; background: rgba(255,255,255,.78); font-size: 25rpx; }

.library-search { box-sizing: border-box; display: flex; align-items: center; gap: 18rpx; height: 84rpx; padding: 0 28rpx; border: 1rpx solid #eeeae5; border-radius: 50rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(90,70,40,.035); margin: 20rpx 0 24rpx; }
.library-search input { flex: 1; min-width: 0; height: 84rpx; padding: 0; border: 0; background: transparent; border-radius: 0; font-size: 26rpx; margin: 0; color: #102f49; }
.category-grid { display: flex; gap: 20rpx; }
.category-tile { position: relative; box-sizing: border-box; flex: 1; min-width: 0; height: 220rpx; padding: 26rpx 24rpx 22rpx; border: 0; border-radius: 24rpx; background: linear-gradient(145deg,#e3f3fc,#e7f4fb); font-size: 26rpx; line-height: 1.5; }
.category-tile.mistake { background: linear-gradient(145deg,#ffe1c7,#ffead8); }
.category-tile.natural_upgrade { background: linear-gradient(145deg,#edf5e5,#f1f7ec); }
.category-tile.selected { box-shadow: inset 0 0 0 2rpx rgba(34,82,62,.13); }
.category-name { margin-top: 12rpx; white-space: nowrap; font-size: 25rpx; }
.category-count { font-size: 46rpx; font-weight: 600; line-height: 1.3; }
.category-chevron { position: absolute; right: 28rpx; bottom: 30rpx; }
.list-heading { margin: 32rpx 0 20rpx; }
.list-heading .subtitle { font-size: 34rpx; }
.list-heading .small.muted { font-size: 23rpx; }
.expression-card { position: relative; padding: 20rpx 54rpx 20rpx 40rpx; margin: 22rpx 0; }
.expression-card:before { content: ""; position: absolute; left: 0; top: 16rpx; bottom: 16rpx; width: 10rpx; border-radius: 8rpx; background: #77b4da; }
.expression-card.mistake:before { background: #ff9762; }
.expression-card.natural_upgrade:before { background: #80b68a; }
.expression-line { display: flex; align-items: baseline; gap: 16rpx; padding: 6rpx 0; font-size: 28rpx; line-height: 1.5; word-break: break-word; }
.expression-label { width: 144rpx; flex-shrink: 0; color: #657b95; font-size: 20rpx; line-height: 1.5; font-weight: 400; }
.expression-value { color: #102c46; font-weight: 500; }
.expression-line .muted { font-size: 26rpx; }
.expression-chevron { position: absolute; right: 24rpx; top: 50%; margin-top: -12rpx; }

/* Scheme C brand banner; menu is provided by the native WeChat capsule. */
.c-brand-header { display: flex; align-items: center; justify-content: space-between; min-height: 112rpx; margin: 0 12rpx 28rpx; }
.c-brand-name { color: #0c2e49; font-size: 44rpx; font-weight: 700; line-height: 1.25; letter-spacing: 0; }
.c-brand-tagline { margin-top: 4rpx; color: #62778d; font-size: 26rpx; font-weight: 400; line-height: 1.5; letter-spacing: 1rpx; }
.c-brand-search { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; padding: 0; margin: 0; background: transparent; border: 0; border-radius: 50%; box-shadow: none; }
.c-brand-search::after { border: 0; }
