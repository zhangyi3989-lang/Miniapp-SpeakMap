.catalog-page .title {
  margin: 12rpx 0 4rpx;
  font-size: 40rpx;
}
.library-search {
  height: 76rpx;
  border: 1rpx solid #ecefe9;
  border-radius: 50rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(90, 70, 40, 0.035);
  margin: 24rpx 0;
}
.category-grid {
  display: flex;
  gap: 14rpx;
}
.category-tile {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #eaf4fd;
  font-size: 23rpx;
}
.category-tile.mistake {
  background: #ffe8d7;
}
.category-tile.natural_upgrade {
  background: #edf5e6;
}
.category-tile.selected {
  border-color: #b5c8b0;
}
.category-count {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}
.list-heading {
  margin: 26rpx 0 10rpx;
}
.list-heading .subtitle {
  margin: 0;
  font-size: 29rpx;
}
.expression-card {
  position: relative;
  padding: 22rpx 22rpx 18rpx 30rpx;
  margin: 16rpx 0;
  border: 0;
}
.expression-card:before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: #80b3d1;
}
.expression-card.mistake:before {
  background: #ff9b6c;
}
.expression-card.natural_upgrade:before {
  background: #93b885;
}
.expression-line {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-word;
}
.expression-label {
  width: 112rpx;
  flex-shrink: 0;
  color: #849497;
  font-size: 22rpx;
  padding-top: 3rpx;
}
.expression-value {
  font-weight: 600;
}
.expression-meta {
  font-size: 20rpx;
  color: #96a19e;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f2ed;
}
