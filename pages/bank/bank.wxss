/* Scheme C: explicit page styles also override older app.wxss spacing. */
page {
  background: #fff8f0;
  background-image: linear-gradient(180deg, #fff0df 0, #fff8f0 300rpx);
  color: #203f56;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 26rpx;
  line-height: 1.55;
}
.page.catalog-page {
  box-sizing: border-box;
  width: 100%;
  max-width: 900rpx;
  margin: 0 auto;
  padding: 6rpx 28rpx 44rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.catalog-page .title {
  color: #203f56;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 0;
}
.catalog-page .subtitle { color: #203f56; font-weight: 600; }
.catalog-page .muted { color: #859397; font-size: 24rpx; line-height: 1.55; }
.catalog-page .small.muted { font-size: 22rpx; }
.catalog-page .marker { background: none; padding: 0; }
.catalog-page .card { background: #ffffff; border-radius: 28rpx; box-shadow: 0 8rpx 26rpx rgba(91, 71, 45, 0.035); }
.catalog-page button.primary {
  background: linear-gradient(180deg, #77aa79, #629968);
  color: #ffffff;
  border: 0;
}

.catalog-page .title {
  margin: 0 0 8rpx;
  font-size: 44rpx;
}
.library-search {
  height: 76rpx;
  border: 1rpx solid #ecefe9;
  border-radius: 50rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(90, 70, 40, 0.035);
  margin: 24rpx 0;
}
.category-grid {
  display: flex;
  gap: 14rpx;
}
.category-tile {
  flex: 1;
  min-width: 0;
  padding: 20rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #eaf4fd;
  font-size: 23rpx;
}
.category-tile.mistake {
  background: #ffe8d7;
}
.category-tile.natural_upgrade {
  background: #edf5e6;
}
.category-tile.selected {
  border-color: #b5c8b0;
}
.category-count {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}
.list-heading {
  margin: 26rpx 0 10rpx;
}
.list-heading .subtitle {
  margin: 0;
  font-size: 29rpx;
}
.expression-card {
  position: relative;
  padding: 22rpx 22rpx 18rpx 30rpx;
  margin: 16rpx 0;
  border: 0;
}
.expression-card:before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: #80b3d1;
}
.expression-card.mistake:before {
  background: #ff9b6c;
}
.expression-card.natural_upgrade:before {
  background: #93b885;
}
.expression-line {
  display: flex;
  gap: 16rpx;
  padding: 6rpx 0;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-word;
}
.expression-label {
  width: 112rpx;
  flex-shrink: 0;
  color: #849497;
  font-size: 22rpx;
  padding-top: 3rpx;
}
.expression-value {
  font-weight: 600;
}
.expression-meta {
  font-size: 20rpx;
  color: #96a19e;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f2ed;
}
