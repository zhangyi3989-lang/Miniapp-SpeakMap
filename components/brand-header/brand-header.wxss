:host { display: block; }
.unified-header { position: relative; box-sizing: border-box; width: 100%; background: transparent; }
.brand-navigation { display: flex; align-items: flex-start; box-sizing: border-box; height: 124rpx; padding: 18rpx 0 20rpx 40rpx; }
.brand-copy { min-width: 0; }
.brand-name { color: #0c2e49; font-size: 42rpx; font-weight: 700; line-height: 1.3; letter-spacing: 0; }
.brand-tagline { margin-top: 4rpx; color: #62778d; font-size: 25rpx; font-weight: 400; line-height: 1.5; letter-spacing: 1rpx; white-space: nowrap; }
.brand-back { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 34rpx; height: 48rpx; margin: 2rpx 20rpx 0 -12rpx; padding: 0; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
.brand-back::after, .brand-search::after { border: 0; }
.back-chevron { width: 18rpx; height: 18rpx; border-left: 3rpx solid #203f56; border-bottom: 3rpx solid #203f56; transform: rotate(45deg); }
.brand-search { position: absolute; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin: 0; padding: 0; background: transparent; border: 0; border-radius: 50%; box-shadow: none; }
