{
  "appid": "touristappid",
  "projectname": "SpeakMap",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true
  },
  "libVersion": "3.7.0",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": "cloudfunctions"
      },
      {
        "type": "folder",
        "value": "migrations"
      },
      {
        "type": "file",
        "value": "README.md"
      },
      {
        "type": "file",
        "value": "package.json"
      }
    ]
  }
}
